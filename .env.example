# Salin ke .env lalu sesuaikan
# TZ harus sama dengan zona waktu timestamp di log server (cek: timedatectl)
TZ=Asia/Jakarta

# UID/GID akun non-root di host yang menjalankan cron (cek: id -u; id -g)
APP_UID=1000
APP_GID=1000

# Folder log di host (biasanya /var/log)
UFW_LOG_DIR=/var/log

# Folder input/output lokal
UFW_IN_DIR=./ufw/in
UFW_OUT_DIR=./ufw/hasil

# IP admin/kantor/monitoring yang diabaikan (pisahkan koma)
ABAIKAN_IP=

# Port dashboard web di host (default 127.0.0.1:8080)
DASHBOARD_PORT=8080
DASHBOARD_HOST=127.0.0.1
